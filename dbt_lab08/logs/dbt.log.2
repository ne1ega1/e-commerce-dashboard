     , d.device_is_mobile
     , d.user_custom_id
     , d.user_domain_id
     , b.file_key_date
FROM browser b
LEFT JOIN location l
	  ON b.event_id = l.event_id
LEFT JOIN geo g
	   ON b.click_id = g.click_id
	  AND g.rn = 1
LEFT JOIN device d
	   ON b.click_id = d.click_id
	  AND d.rn = 1
    
  )
      
      
