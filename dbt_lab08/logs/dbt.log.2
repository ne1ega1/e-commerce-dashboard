WITH purchase_events AS (
	SELECT event_timestamp
		 , click_id
		 , page_url
		 , page_url_path
		 , device_type
		 , device_is_mobile
		 , browser_name
		 , utm_medium
		 , utm_source
		 , utm_content
		 , utm_campaign
