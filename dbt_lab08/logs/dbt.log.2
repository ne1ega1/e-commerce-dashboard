	 , pe.utm_campaign
	 , pe.user_custom_id
FROM purchase_events_fourth_type_filtered pe
LEFT JOIN conf_time c
	  ON pe.click_id = c.click_id
WHERE cur_type = 'product'
  AND c.confirmation_time > pe.event_timestamp
