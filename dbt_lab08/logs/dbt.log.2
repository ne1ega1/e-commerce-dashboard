	 	 , CASE
		 	   WHEN lower(next_step) LIKE '/product_%' THEN 'product'
		 	   ELSE substring(lower(next_step), 2)
		 END AS next_type
	FROM `lab08`.`core_events_mv`
	WHERE click_id IN (
			   SELECT DISTINCT click_id
                           FROM core_events
			   WHERE page_url_path = '/confirmation'
			     )
