	   --, pe.next_type_in_filt
	   , pe.device_type
	   , pe.device_is_mobile
	   , pe.browser_name
	   , pe.utm_medium
	   , pe.utm_source
	   , pe.utm_content
	   , pe.utm_campaign
	   , pe.user_custom_id
          )
        
