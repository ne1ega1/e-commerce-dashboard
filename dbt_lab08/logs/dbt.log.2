	 , pe.browser_name
	 , pe.utm_medium
	 , pe.utm_source
	 , pe.utm_content
	 , pe.utm_campaign
	 , pe.user_custom_id
FROM purchase_events_fourth_type_filtered pe
LEFT JOIN conf_time c
