	 , next_type
	 , next_type_in_filt
	 , device_type
	 , device_is_mobile
	 , browser_name
	 , utm_medium
	 , utm_source
	 , utm_content
	 , utm_campaign
	 , user_custom_id
	 , leadInFrame(next_type, 2) OVER (PARTITION BY click_id ORDER BY event_timestamp ROWS BETWEEN CURRENT ROW AND unbounded FOLLOWING) next_type_in_filt_2
