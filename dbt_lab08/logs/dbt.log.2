  create view `lab08`.`core_events__dbt_tmp` 
  
    
    
  as (
    WITH browser AS (
	SELECT event_id
	     , event_timestamp
	     , event_type
	     , click_id
	     , browser_name
	     , browser_user_agent
	     , browser_language
	     , file_key_date
	FROM `lab08`.`raw_browser_events`
)
   , location AS (
	SELECT event_id
	     , page_url
	     , page_url_path
	     , referer_url
	     , referer_medium
	     , utm_medium
	     , utm_source
	     , utm_content
	     , utm_campaign
	FROM `lab08`.`raw_location_events`
)
   , geo AS (
	SELECT click_id
	     , geo_country
	     , geo_timezone
	     , geo_region_name
	     , ip_address
	     , geo_latitude
	     , geo_longitude
	     , row_number() over(partition by click_id, geo_country, geo_timezone, geo_region_name, ip_address, geo_latitude, geo_longitude) AS rn
	FROM `lab08`.`raw_geo_events`
)
   , device AS (
	SELECT click_id
	     , os
	     , os_name
	     , os_timezone
	     , device_type
	     , device_is_mobile
	     , user_custom_id
	     , user_domain_id
	     , row_number() over(partition by click_id, os, os_name, os_timezone, device_type, device_is_mobile, user_custom_id, user_domain_id) AS rn
	FROM `lab08`.`raw_device_events`
)
SELECT b.event_id as event_id
     , b.event_timestamp
