	 	   WHEN lower(page_url_path) = '/cart' AND next_step = '/payment' THEN 1
	 	   WHEN lower(page_url_path) = '/payment' AND next_step = '/confirmation' THEN 1
	 	   WHEN lower(page_url_path) = '/confirmation' THEN 1
	 	   ELSE 0
