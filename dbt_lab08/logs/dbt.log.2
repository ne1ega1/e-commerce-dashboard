			   WHEN cur_type = 'product' AND  next_type = 'cart' and next_type_in_filt != '' and next_type_in_filt_2 != '' THEN 2
			   ELSE 0
		   END as fl_buy
	FROM purchase_events_fourth_type
	WHERE (fl_buy > 0
