)
   , location AS (
	SELECT event_id
	     , page_url
	     , page_url_path
	     , referer_url
	     , referer_medium
	     , utm_medium
	     , utm_source
	     , utm_content
	     , utm_campaign
	FROM `lab08`.`raw_location_events`
)
   , geo AS (
	SELECT click_id
	     , geo_country
	     , geo_timezone
	     , geo_region_name
	     , ip_address
	     , geo_latitude
