  create view `lab08`.`core_events__dbt_tmp` 
  
    
    
  as (
    WITH browser AS (
	SELECT event_id
	     , event_timestamp
	     , event_type
	     , click_id
	     , browser_name
	     , browser_user_agent
	     , browser_language
	     , file_key_date
