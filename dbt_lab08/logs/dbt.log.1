     , d.os_timezone
     , d.device_type
     , d.device_is_mobile
     , d.user_custom_id
     , d.user_domain_id
     , b.file_key_date
FROM browser b
LEFT JOIN location l
	  ON b.event_id = l.event_id
LEFT JOIN geo g
