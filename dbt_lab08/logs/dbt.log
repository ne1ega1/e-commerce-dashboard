			   else substring(lower(page_url_path), 2)
		   end as cur_type
		 , case
			   when lower(next_step) like '/product_%' then 'product'
			   else substring(lower(next_step), 2)
		   end as next_type
	from `lab08`.`core_events_mv`
	where click_id in (select distinct click_id
