	from purchase_events_fourth_type
	where (fl_buy > 0
			   or cur_type = 'confirmation')
)
   , conf_time as (
	select click_id
		 , event_timestamp as confirmation_time
	from purchase_events_fourth_type_filtered
	where cur_type = 'confirmation'
)
